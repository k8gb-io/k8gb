FROM python:3.12-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY relay.proto .
RUN python -m grpc_tools.protoc -I . --python_out=. --grpc_python_out=. relay.proto
COPY ckf.py relay_client.py router.py .
ENV HF_HOME=/tmp/huggingface USE_TORCH=0 HF_HUB_DISABLE_XET=1 DO_NOT_TRACK=1
USER 1000:1000
ENTRYPOINT ["python", "router.py"]
